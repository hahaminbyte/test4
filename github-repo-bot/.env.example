# GitHub Repository Enhancement Bot Configuration

# GitHub Personal Access Token
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, delete_repo, user
GITHUB_TOKEN=ghp_your_token_here

# OpenAI API Key (required for deep AI analysis)
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini

# Default Repository Settings
DEFAULT_PRIVATE=true
DEFAULT_COMMITS=50
DEFAULT_DAYS_BACK=90

# Bot Configuration
BOT_NAME="GitHub Enhancement Bot"
BOT_VERSION="2.0.0"
